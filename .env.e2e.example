# Database (separate from dev so they can run side-by-side).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=appdb_e2e
DB_HOST_PORT=5433

# Backend.
AUTH_SECRET=e2e-insecure-do-not-use-in-prod

GOOGLE_CLIENT_ID=e2e-google-client-id
GOOGLE_CLIENT_SECRET=e2e-google-client-secret
BACKEND_HOST_PORT=8000
MOTOR_HOST_PORT=8001

# URLs as seen from the browser. Must match the host ports above and the CORS list.
PUBLIC_API_ORIGIN=http://localhost:8000
PUBLIC_WEB_ORIGIN=http://localhost:5173
PUBLIC_DASHBOARD_ORIGIN=http://localhost:5174
PUBLIC_BACKOFFICE_ORIGIN=http://localhost:5175
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Superuser to seed.
SUPERUSER_EMAIL=e2e-admin@example.com
SUPERUSER_PASSWORD=E2E-Admin-123!
SEED_ORG_SLUG=e2e-org
SEED_ORG_NAME="E2E Organization"

# Frontends.
WEB_HOST_PORT=5173
DASHBOARD_HOST_PORT=5174
BACKOFFICE_HOST_PORT=5175

# Image references (only used in the non-local compose flow).
IMAGE_REGISTRY=ghcr.io/your-gh-owner
BACKEND_VERSION=latest
MOTOR_VERSION=latest
FRONTENDS_VERSION=latest
