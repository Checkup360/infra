# Database
POSTGRES_USER={{ postgres_user }}
POSTGRES_PASSWORD={{ vault_postgres_password }}
POSTGRES_DB={{ postgres_db }}

# Authentication & Secrets
AUTH_SECRET={{ vault_auth_secret }}
GOOGLE_CLIENT_ID={{ vault_google_client_id }}
GOOGLE_CLIENT_SECRET={{ vault_google_client_secret }}
PAYLOAD_SECRET={{ vault_payload_secret }}
SUPERUSER_EMAIL={{ superuser_email }}
SUPERUSER_PASSWORD={{ vault_superuser_password }}
SEED_OVERWRITE={{ seed_overwrite }}

# Domains and Origins
API_HOST={{ api_host }}
WEB_HOST={{ web_host }}
DASHBOARD_HOST={{ dashboard_host }}
BACKOFFICE_HOST={{ backoffice_host }}
CMS_HOST={{ cms_host }}
CADDY_EMAIL={{ caddy_email }}
PUBLIC_WEB_ORIGIN={{ public_web_origin }}
CORS_ALLOWED_ORIGINS={{ cors_allowed_origins }}

# SMTP
SMTP_HOST={{ smtp_host }}
SMTP_PORT={{ smtp_port }}
SMTP_USER={{ vault_smtp_user }}
SMTP_PASSWORD={{ vault_smtp_password }}

# Images and Versions
IMAGE_REGISTRY={{ image_registry }}
BACKEND_VERSION={{ backend_version }}
FRONTENDS_VERSION={{ frontends_version }}
CMS_VERSION={{ cms_version }}
ENGINE_VERSION={{ engine_version }}
CADDY_VERSION={{ caddy_version }}
DOZZLE_VERSION={{ dozzle_version }}

# Storage
UPLOAD_DIR={{ upload_dir | default('/app/uploads') }}

