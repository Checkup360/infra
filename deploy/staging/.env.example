# DB config
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<strong-secure-password>
POSTGRES_DB=appdb_staging

# Backend auth config
AUTH_SECRET=<generate-a-secure-random-string>
GOOGLE_CLIENT_ID=<google-oauth-client-id>
GOOGLE_CLIENT_SECRET=<google-oauth-client-secret>

# Domain configuration
API_HOST=api.staging.yourdomain.com
WEB_HOST=staging.yourdomain.com
DASHBOARD_HOST=dashboard.staging.yourdomain.com
BACKOFFICE_HOST=backoffice.staging.yourdomain.com
CADDY_EMAIL=youremail@example.com

# Backend uses these for CORS (derived from above hosts)
PUBLIC_WEB_ORIGIN=https://${WEB_HOST}
PUBLIC_DASHBOARD_ORIGIN=https://${DASHBOARD_HOST}
PUBLIC_BACKOFFICE_ORIGIN=https://${BACKOFFICE_HOST}
CORS_ALLOWED_ORIGINS=https://${WEB_HOST},https://${DASHBOARD_HOST},https://${BACKOFFICE_HOST}

# Image registry
IMAGE_REGISTRY=ghcr.io/your-github-owner
BACKEND_VERSION=latest
FRONTENDS_VERSION=latest
